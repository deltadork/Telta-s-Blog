
---
const apiBase = "https://telta-comments-api.87kruk.workers.dev";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Comment moderation · Telta's Blog</title>

    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        padding: 40px 18px;
        background: Canvas;
        color: CanvasText;
      }

      #admin-comments-page {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
      }

      h1 {
        margin: 0 0 8px;
        font-size: 1.8rem;
        font-weight: 750;
        letter-spacing: -0.035em;
      }

      h2 {
        margin: 0 0 14px;
        font-size: 1.15rem;
        font-weight: 650;
      }

      p {
        line-height: 1.55;
      }

      input, select, button {
        font: inherit;
      }

      input, select {
        padding: 10px 12px;
        border: 1px solid color-mix(in srgb, CanvasText 22%, transparent);
        border-radius: 9px;
        background: Canvas;
        color: CanvasText;
      }

      button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 8px 14px;
        border: 1px solid color-mix(in srgb, CanvasText 22%, transparent);
        border-radius: 9px;
        background: color-mix(in srgb, CanvasText 6%, Canvas);
        color: CanvasText;
        cursor: pointer;
        transition: background .15s, border-color .15s, opacity .15s;
      }

      button:hover:not(:disabled) {
        background: color-mix(in srgb, CanvasText 12%, Canvas);
      }

      button:disabled {
        opacity: .5;
        cursor: wait;
      }

      .primary {
        background: #2563eb;
        border-color: #2563eb;
        color: white;
      }

      .primary:hover:not(:disabled) {
        background: #1d4ed8;
      }

      .danger {
        color: #dc2626;
        border-color: color-mix(in srgb, #dc2626 35%, transparent);
      }

      .danger:hover:not(:disabled) {
        background: color-mix(in srgb, #dc2626 10%, Canvas);
      }

      .trusted {
        color: #16a34a;
      }

      .muted {
        opacity: .65;
        font-size: .9rem;
      }

      .intro {
        margin: 0 0 24px;
      }

      .card {
        padding: 20px;
        margin: 16px 0;
        border: 1px solid color-mix(in srgb, CanvasText 16%, transparent);
        border-radius: 14px;
        background: color-mix(in srgb, CanvasText 2%, Canvas);
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin: 22px 0 12px;
      }

      .toolbar label {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: .9rem;
      }

      .toolbar select {
        min-width: 135px;
      }

      .comment-meta {
        margin: 7px 0 12px;
        font-size: .82rem;
        opacity: .6;
      }

      .comment-body {
        margin: 0 0 16px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.65;
      }

      .actions {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  align-items: center;
  gap: 12px !important;
  padding-top: 16px;
  margin-top: 14px;
  border-top: 1px solid color-mix(in srgb, CanvasText 12%, transparent);
}

.actions button {
  display: inline-flex !important;
  flex: 0 0 auto !important;
  width: auto !important;
  min-width: 90px;
  margin: 0 4px 4px 0;
  white-space: nowrap;
}

      .trust-note {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0 0 14px;
        font-size: .82rem;
        color: #16a34a;
      }

      #message {
        min-height: 22px;
        margin: 10px 0;
      }

      #login-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 420px;
      }

      #login-form input {
        display: block;
        width: 100%;
        margin-top: 7px;
      }

      #login-form button {
        align-self: flex-start;
      }

      [hidden] {
        display: none !important;
      }

      @media (max-width: 520px) {
        body {
          padding: 25px 14px;
        }

        .card {
          padding: 15px;
        }

        .actions button {
          flex: 1 1 auto;
        }

        .toolbar {
          align-items: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <main id="admin-comments-page">
      <h1>Comment moderation</h1>

      <p class="muted intro">
        Manage comments on Telta's Blog. Only approved comments are visible publicly.
      </p>

      <section id="login" class="card">
        <h2>Administrator login</h2>

        <form id="login-form">
          <label>
            Password
            <input
              type="password"
              name="password"
              required
              autocomplete="current-password"
            />
          </label>

          <button class="primary" type="submit">Log in</button>
        </form>
      </section>

      <section id="panel" hidden>
        <div class="toolbar">
          <label>
            Show
            <select id="status">
              <option value="pending">Pending</option>
              <option value="approved">Approved</option>
              <option value="rejected">Rejected</option>
            </select>
          </label>

          <button id="refresh" type="button">Refresh</button>
          <button id="logout" type="button">Log out</button>
        </div>

        <p id="message" class="muted" role="status"></p>
        <div id="comments"></div>
      </section>
    </main>

    <script define:vars={{ apiBase }}>
      const login = document.getElementById("login");
      const panel = document.getElementById("panel");
      const message = document.getElementById("message");
      const container = document.getElementById("comments");
      const statusSelect = document.getElementById("status");

      let token =
        sessionStorage.getItem("telta-comments-admin-token") || "";

      const headers = () => ({
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
      });

      const node = (tag, text, cls = "") => {
        const element = document.createElement(tag);
        element.textContent = text;
        element.className = cls;
        return element;
      };

      function showPanel() {
        login.hidden = true;
        panel.hidden = false;
        load();
      }

      function action(label, callback, cls = "") {
        const button = node("button", label, cls);
        button.type = "button";
        button.addEventListener("click", callback);
        return button;
      }

      async function load() {
        message.textContent = "Loading…";
        container.replaceChildren();

        try {
          const response = await fetch(
            `${apiBase}/admin/comments?status=${statusSelect.value}`,
            { headers: headers() }
          );

          const data = await response.json();

          if (response.status === 401) {
            logout();
            throw new Error("Session expired. Please log in again.");
          }

          if (!response.ok) {
            throw new Error(data.error || "Could not load comments.");
          }

          message.textContent =
            `${data.comments.length} ${statusSelect.value} comment(s)`;

          if (!data.comments.length) {
            container.append(
              node("p", "Nothing here yet.", "muted")
            );
            return;
          }

          for (const comment of data.comments) {
            const card = node("article", "", "card");

            card.append(
              node(
                "strong",
                `${comment.nickname} · ${comment.post_slug}`
              )
            );

            card.append(
              node(
                "p",
                `${new Date(comment.created_at * 1000).toLocaleString()} · ID ${comment.id}${comment.parent_id ? ` · Reply to #${comment.parent_id}` : ""}`,
                "comment-meta"
              )
            );

            card.append(
              node("p", comment.content, "comment-body")
            );

            if (comment.email) {
              card.append(
                node("p", `Email: ${comment.email}`, "muted")
              );
            }

            const actions = node("div", "", "actions");

            if (comment.status !== "approved") {
              actions.append(
                action(
                  "Approve",
                  () => update(comment.id, "approved"),
                  "primary"
                )
              );
            }

            if (comment.status !== "rejected") {
              actions.append(
                action(
                  "Reject",
                  () => update(comment.id, "rejected")
                )
              );
            }

            if (comment.status !== "pending") {
              actions.append(
                action(
                  "Return to pending",
                  () => update(comment.id, "pending")
                )
              );
            }

            if (comment.commenter_id && comment.trusted) {
              card.append(
                node(
                  "p",
                  "✓ Trusted commenter · Future comments are automatically approved.",
                  "trust-note"
                )
              );

              actions.append(
                action(
                  "Revoke trust",
                  () => changeTrust(comment.commenter_id, "DELETE"),
                  "danger"
                )
              );
            } else if (
              comment.commenter_id &&
              comment.status === "approved"
            ) {
              actions.append(
                action(
                  "Trust commenter",
                  () => changeTrust(
                    comment.commenter_id,
                    "POST",
                    comment.nickname
                  ),
                  "primary"
                )
              );
            }

            actions.append(
              action(
                "Delete",
                () => remove(comment.id),
                "danger"
              )
            );

            card.append(actions);
            container.append(card);
          }
        } catch (error) {
          message.textContent = error.message;
        }
      }

      async function update(id, status) {
        try {
          const response = await fetch(
            `${apiBase}/admin/comments/${id}/status`,
            {
              method: "PATCH",
              headers: headers(),
              body: JSON.stringify({ status }),
            }
          );

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || "Update failed.");
          }

          await load();
        } catch (error) {
          message.textContent = error.message;
        }
      }

      async function changeTrust(commenterId, method, nickname = "") {
        try {
          const response = await fetch(
            `${apiBase}/admin/trusted/${commenterId}`,
            {
              method,
              headers: headers(),
              ...(method === "POST"
                ? { body: JSON.stringify({ nickname }) }
                : {}),
            }
          );

          const data = await response.json();

          if (!response.ok) {
            throw new Error(
              data.error || "Could not update trusted status."
            );
          }

          message.textContent =
            method === "POST"
              ? "Commenter trusted. Future comments will be auto-approved."
              : "Trust revoked. Future comments will require moderation.";

          await load();
        } catch (error) {
          message.textContent = error.message;
        }
      }

      async function remove(id) {
        if (!confirm(`Permanently delete comment #${id}?`)) {
          return;
        }

        try {
          const response = await fetch(
            `${apiBase}/admin/comments/${id}`,
            {
              method: "DELETE",
              headers: headers(),
            }
          );

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || "Delete failed.");
          }

          await load();
        } catch (error) {
          message.textContent = error.message;
        }
      }

      function logout() {
        token = "";
        sessionStorage.removeItem("telta-comments-admin-token");
        panel.hidden = true;
        login.hidden = false;
        container.replaceChildren();
      }

      document.getElementById("login-form").addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          const form = event.currentTarget;
          const password = new FormData(form).get("password");
          const button = form.querySelector("button");

          button.disabled = true;
          message.textContent = "";

          try {
            const response = await fetch(`${apiBase}/admin/login`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password }),
            });

            const data = await response.json();

            if (!response.ok) {
              throw new Error(data.error || "Login failed.");
            }

            token = data.token;

            sessionStorage.setItem(
              "telta-comments-admin-token",
              token
            );

            form.reset();
            showPanel();
          } catch (error) {
            message.textContent = error.message;
            alert(error.message);
          } finally {
            button.disabled = false;
          }
        }
      );

      document.getElementById("refresh").addEventListener("click", load);
      document.getElementById("logout").addEventListener("click", logout);
      statusSelect.addEventListener("change", load);

      if (token) {
        showPanel();
      }
    </script>
  </body>
</html>
